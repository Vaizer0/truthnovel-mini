/* حاوية الأزرار لضمان التوسيط */
.article-navigation {
    display: flex;
		
    justify-content: center; /* توسيط الأزرار أفقياً */
    align-items: center; /* توسيط الأزرار عمودياً */
    margin: 20px auto; /* مسافة أعلى وأسفل مع توسيط الحاوية */
    width: 100%; /* تأكيد عرض الحاوية بالكامل */
    max-width: 100%; /* منع تمدد الحاوية خارج الصفحة */
    text-align: center; /* محاذاة النص داخل الحاوية */
    box-sizing: border-box; /* تضمين الحواف والهوامش في الحاوية */
}

/* تصميم الأزرار */
.next-post, .prev-post {
    display: inline-block;
    margin: 10px; /* مسافة بين الزرين */
    padding: 15px 30px; /* زيادة المسافة داخل الأزرار لتكبيرها */
    background-color: #0073aa;
    color: white;
    text-decoration: none;
    border-radius: 5px;
    font-size: 16px; /* حجم خط مناسب */
    transition: background-color 0.3s ease; /* تأثير ناعم عند التمرير */
    text-align: center; /* محاذاة النص داخل الأزرار */
    width: auto; /* جعل الأزرار تتناسب مع محتواها */
}

/* تأثير عند التمرير */
.next-post:hover, .prev-post:hover {
    background-color: #005177;
}

/* تخصيص للموبايل (شاشات صغيرة) */
@media (max-width: 767px) {
    .next-post, .prev-post {
        padding: 12px 25px; /* تقليل المسافات داخل الأزرار لتناسب الشاشات الصغيرة */
        font-size: 14px; /* تقليل حجم الخط */
    }

    .article-navigation {
        flex-direction: column; /* ترتيب الأزرار عمودياً بدلاً من أفقي */
